Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/srv/neutral-home/.local/bin/uv run python -m todo_system.worker maintenance
StandardOutput=append:/srv/neutral-vault/logs/macp-maintenance.out.log
StandardError=append:/srv/neutral-vault/logs/macp-maintenance.err.log
TimeoutStartSec=1800
