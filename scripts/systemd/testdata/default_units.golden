OnUnitActiveSec=5min
Unit=macp-maintenance.service

[Install]
WantedBy=timers.target
##### macp-todo-sync.service
[Unit]
Description=macp todo-sync daemon (md -> todo.db, calendar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/srv/neutral-home/.local/bin/uv run python -u -m todo_system.cli daemon --interval 3 --calendar-sync
StandardOutput=append:/srv/neutral-vault/logs/macp-todo-sync.out.log
StandardError=append:/srv/neutral-vault/logs/macp-todo-sync.err.log
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
##### macp-dashboard.service
[Unit]
Description=macp live dashboard (loopback :8787; tailscale serve fronts it)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
EnvironmentFile=/srv/neutral-home/.config/macp/dashboard.env
ExecStart=/srv/neutral-home/.local/bin/uv run python -u /srv/neutral-engine/scripts/macp_dashboard.py --host 127.0.0.1 --port 8787 --no-open
StandardOutput=append:/srv/neutral-vault/logs/macp-dashboard.out.log
StandardError=append:/srv/neutral-vault/logs/macp-dashboard.err.log
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
##### macp-brief.service
[Unit]
Description=macp morning brief
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
