##### macp-health.service
[Unit]
Description=macp weekly health report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/usr/bin/python3 /srv/neutral-engine/scripts/health_report.py
StandardOutput=append:/srv/neutral-vault/logs/macp-health.out.log
StandardError=append:/srv/neutral-vault/logs/macp-health.err.log
TimeoutStartSec=1800
##### macp-health.timer
[Unit]
Description=macp weekly health report (timer)

[Timer]
OnCalendar=Sun *-*-* 08:30:00
Persistent=true
Unit=macp-health.service

[Install]
WantedBy=timers.target
##### ENV_TEMPLATE
# MaestroACP daemon environment (systemd --user EnvironmentFile). 0600.
PATH=/srv/neutral-home/.local/bin:/usr/local/bin:/usr/bin:/bin
HOME=/srv/neutral-home
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ANDROID_HOME=/srv/neutral-home/Android/sdk
ANDROID_SDK_ROOT=/srv/neutral-home/Android/sdk
PYTHONUNBUFFERED=1
MACP_HOST_ID=macp-host
CLAUDE_RC_NAME=macp-host
# Pin the daemon's effective label prefix / calendar id in the process env so
# daemonctl.label_prefix() resolves them regardless of the unit's WorkingDirectory
# (env is highest priority). Empty when this host has no config/env → the resolver
# falls through to its neutral default, which is harmless.
MACP_LABEL_PREFIX=
MACP_CALENDAR_ID=
