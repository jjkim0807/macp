##### macp-runner-worker-default.service
[Unit]
Description=macp worker-default runner (v2 staged pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/srv/neutral-home/.local/bin/uv run python -m todo_system.orchestrator.runner --agent worker-default --mode live-staged --uri file://Worker/agents --daemon
StandardOutput=append:/srv/neutral-vault/logs/macp-runner-worker-default.out.log
StandardError=append:/srv/neutral-vault/logs/macp-runner-worker-default.err.log
Restart=always
RestartSec=30
OOMPolicy=continue

[Install]
WantedBy=default.target
##### macp-orchestrator.service
[Unit]
Description=macp orchestrator tick (dispatch/collect/dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/neutral-vault
EnvironmentFile=/srv/neutral-home/.config/macp/env
ExecStart=/bin/zsh /srv/neutral-engine/scripts/orchestrator_tick.sh
StandardOutput=append:/srv/neutral-vault/logs/macp-orchestrator.out.log
StandardError=append:/srv/neutral-vault/logs/macp-orchestrator.err.log
TimeoutStartSec=1800
##### macp-orchestrator.timer
[Unit]
Description=macp orchestrator (timer)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=macp-orchestrator.service

[Install]
WantedBy=timers.target
