#!/usr/bin/env bash
# macp-recall — search the vault's memory index with a free-text question
# (`python -m todo_system.recall`) from ANY directory:
#   macp-recall "<question or symptom>" [--k 5]
# prints title, path and a one-line gist per result (at most 4 KB); Read a path
# for the rest. Worker stages run in other repos' checkouts and their tool
# whitelist splits on spaces, so a rule like `Bash(python3 -m todo_system.recall:*)`
# can never match; this wrapper gives the whitelist a single space-free name:
# `Bash(macp-recall:*)` (todo_system/orchestrator/stages.py RECALL_TOOL_RULE).
# Read-only towards the vault. A stage's calls are recorded in the file named by
# MACP_RECALL_LOG (the runner sets it to <run_dir>/recall.log).
# Install: the maintenance tick copies this to ~/.local/bin (worker.sync_wrappers);
# by hand: `cp scripts/macp-recall ~/.local/bin/macp-recall && chmod +x ~/.local/bin/macp-recall`.
# Interpreter + import root, same as macp-sms: prefer the ENGINE checkout the
# daemons run from (MACP_ENGINE_ROOT, default ~/Projects/macp) — its venv is also
# the one that carries sqlite-vec, which the index's vector table needs.
# Fallback order: engine checkout → vault venv (installed engine) → python3.
MACP_REPO="${MACP_REPO:-${MACP_VAULT_ROOT:-$HOME/Projects/MaestroACP}}"
MACP_ENGINE_ROOT="${MACP_ENGINE_ROOT:-$HOME/Projects/macp}"
if [ -x "$MACP_ENGINE_ROOT/.venv/bin/python" ] && [ -d "$MACP_ENGINE_ROOT/todo_system" ]; then
  PY="$MACP_ENGINE_ROOT/.venv/bin/python"; ROOT="$MACP_ENGINE_ROOT"
else
  PY="$MACP_REPO/.venv/bin/python"; ROOT="$MACP_REPO"
  [ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
fi
export MACP_VAULT_ROOT="${MACP_VAULT_ROOT:-$MACP_REPO}"
exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m todo_system.recall "$@"
