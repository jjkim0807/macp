#!/usr/bin/env bash
# App test node (macp-app-test): an on-demand Android emulator host, separate from HQ.
# n2-standard-4 spot + nested virtualization; lifecycle per node_mode (see below).
# AVD api30 = android-30 google_apis x86_64, 1072x1448 @300dpi (Crema-like).
# Override the node/zone with APP_TEST_NODE/APP_TEST_ZONE; pick a different AVD per run with `boot <avd>`.
#
#   scripts/app-test-node start                 # bring the VM up (create or start), wait for ssh
#   scripts/app-test-node shot <apk> [wait_s]   # boot emulator, install+launch, pull screenshot
#   scripts/app-test-node boot [avd]            # boot the AVD only (idempotent) — for a scenario driver
#   scripts/app-test-node push <local> <remote> # scp a local file to the node (~ expands on the node)
#   scripts/app-test-node pull <remote> <local> # scp a node file back to the host
#   scripts/app-test-node ssh '<cmd>'           # run a command on the node
#   scripts/app-test-node stop                  # tear the VM down (always do this when done)
#
# Screenshots land in ./app-test-shots/<pkg>-<ts>.png. A spot preemption stops or
# deletes the VM; `start` again (it recreates a deleted one) and retry once.
#
# Lifecycle: start/stop run the engine helper
# (python -m todo_system.orchestrator.remote_gate node-up|node-down), which follows
# `node_mode` in the vault's .macp/remote_gate.json:
#   start-stop     `instances start/stop` of a kept VM (its disk is billed while stopped).
#   create-delete  start creates the VM from the config's `image_family` with the
#                  config's spec (spot, nested virtualization, boot disk, …) and a
#                  `--max-run-duration` DELETE backstop; stop deletes it with its boot
#                  disk, so only the image remains between runs. An existing VM is
#                  reused (running) or started (stopped); an absent one on stop is ok.
# The helper runs on $APP_TEST_PYTHON (default python3; the engine passes its own) and
# needs the vault root (MACP_VAULT_ROOT). If it cannot run at all (no vault config,
# import failure) start/stop warn and fall back to a direct gcloud start/stop.
# APP_TEST_SSH_WAIT (default 300s) bounds the ssh wait after start: a fresh create
# restores the disk from the image and boots slower than a start.
#
# Image refresh (create-delete) — after changing the SDK/AVD/system on the node:
#   1. scripts/app-test-node start; make the change over `ssh`; ssh 'sudo sync'
#      (the VM self-deletes after per_run_vm_ttl_min — finish within it)
#   2. gcloud compute instances stop <node> --zone <zone>          # stop, NOT delete
#   3. gcloud compute images create <family>-$(date +%Y%m%d) --source-disk <node> \
#        --source-disk-zone <zone> --family <family> --storage-location <region>
#   4. gcloud compute instances delete <node> --zone <zone> --quiet # boot disk goes too
#   5. optional: delete the previous image (gcloud compute images list --filter=family=<family>)
# New creates take the newest image in the family — no config edit needed.
#
# APP_TEST_NODE_MODE=local: the same subcommands against an emulator on THIS host (a
# remote runner with capability `device`, e.g. a MacBook). "ssh" runs the command
# locally with HOME=$APP_TEST_LOCAL_HOME (default ~/.macp-app-test-node, where
# `android` links to $ANDROID_HOME), so node-side `~/android/...` and `~/under-test.apk`
# paths work unchanged; push/pull become cp; start checks the SDK; stop kills the
# emulator. GRADLE_USER_HOME / ANDROID_USER_HOME / ANDROID_AVD_HOME keep pointing at
# the real home so builds reuse the Gradle cache and the AVD is found. The local host
# needs `emulator`, `platform-tools`, a build-tools with aapt2 and an AVD named api30.
set -euo pipefail
G=${GCLOUD:-/snap/bin/gcloud}
NODE=${APP_TEST_NODE:-macp-app-test}
ZONE=${APP_TEST_ZONE:-us-central1-a}
OUT=${APP_TEST_OUT:-./app-test-shots}
BOOT_TIMEOUT=${APP_TEST_BOOT_TIMEOUT:-400}
POLL_INTERVAL=${APP_TEST_POLL_INTERVAL:-3}
# Launch-intent extras for `shot` (screen_check._launch_env sets BOTH or NEITHER):
# EXTRAS = the already-quoted `--es/--ez/--ei …` tokens, ACTIVITY = the component
# to start. With either empty, `shot` launches with the original monkey intent.
# A sign-in-gated app needs these to get past its login screen.
EXTRAS=${APP_TEST_LAUNCH_EXTRAS:-}
ACTIVITY=${APP_TEST_ACTIVITY:-}
SSH_WAIT=${APP_TEST_SSH_WAIT:-300}
ENGINE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# The engine's node-up / node-down for THIS script's node/zone (see Lifecycle).
# rc 3 (and 127) = the helper itself is unavailable; any other rc is its verdict.
_engine() {
  APP_TEST_NODE="$NODE" APP_TEST_ZONE="$ZONE" \
  PYTHONPATH="$ENGINE_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    "${APP_TEST_PYTHON:-python3}" -c 'import sys
try:
    from todo_system.orchestrator import remote_gate
except Exception as e:
    print(f"app-test-node: engine helper unavailable ({type(e).__name__}: {e})", file=sys.stderr)
    sys.exit(3)
sys.exit(remote_gate._main(sys.argv[1:]))' "$1"
}

_ssh() { "$G" compute ssh "$NODE" --zone "$ZONE" --internal-ip --quiet --command "$1"; }
_scp() { "$G" compute scp "$@" --zone "$ZONE" --internal-ip --quiet; }
# Node-side emulator launch line for `$1` (AVD name), fire-and-forget.
_emu_launch() {
  printf '%s' 'export ANDROID_SDK_ROOT=~/android
        setsid sg kvm -c "~/android/emulator/emulator -avd '"$1"' -no-window -no-audio -no-snapshot-save -no-boot-anim -gpu swiftshader_indirect" </dev/null >~/emu.log 2>&1 &
        disown'
}

LOCAL=0
if [ "${APP_TEST_NODE_MODE:-}" = local ]; then
  LOCAL=1
  REAL_HOME=$HOME
  NODE_HOME=${APP_TEST_LOCAL_HOME:-$HOME/.macp-app-test-node}
  SDK=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}
  mkdir -p "$NODE_HOME"
  ln -sfn "$SDK" "$NODE_HOME/android"
  # The emulator runs as <real sdk>/emulator/qemu/<host>/qemu-system-*. Match THIS
  # sdk's real path only: a bare "/emulator/qemu/" also matched an unrelated shell
  # whose command line merely mentioned it, and `stop` then waited its full 30s.
  QEMU_PAT="$(cd -P "$SDK" 2>/dev/null && pwd || printf '%s' "$SDK")/emulator/qemu/"
  _ssh() {
    HOME="$NODE_HOME" \
    GRADLE_USER_HOME="${GRADLE_USER_HOME:-$REAL_HOME/.gradle}" \
    ANDROID_USER_HOME="${ANDROID_USER_HOME:-$REAL_HOME/.android}" \
    ANDROID_AVD_HOME="${ANDROID_AVD_HOME:-$REAL_HOME/.android/avd}" \
      bash -c "$1"
  }
  # "<node>:<path>" → a path under NODE_HOME (`~/x` and `x` both mean NODE_HOME/x).
  _local_path() {
    local r=${1#*:}
    case "$r" in
      "~/"*) r=${r#"~/"} ;;
      "~") r= ;;
    esac
    case "$r" in /*) printf '%s' "$r" ;; *) printf '%s' "$NODE_HOME/$r" ;; esac
  }
  _scp() {
    local src=$1 dst=$2
    case "$src" in "$NODE:"*) src=$(_local_path "$src") ;; esac
    case "$dst" in "$NODE:"*) dst=$(_local_path "$dst") ;; esac
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
  }
  # setsid / sg kvm do not exist on macOS; nohup + disown detaches the same way.
  _emu_launch() {
    printf '%s' 'export ANDROID_SDK_ROOT=~/android
        nohup ~/android/emulator/emulator -avd '"$1"' -no-window -no-audio -no-snapshot-save -no-boot-anim -gpu swiftshader_indirect </dev/null >~/emu.log 2>&1 &
        disown'
  }
fi

# A cold boot can keep an ssh channel open for 40s+; a transient drop (rc 255)
# on any single short call should not fail the whole `shot`. Retry once.
_ssh_retry() { _ssh "$1" || _ssh "$1"; }
_scp_retry() { _scp "$@" || _scp "$@"; }

cmd=${1:-}; shift || true
case "$cmd" in
  start)
    if [ "$LOCAL" = 1 ]; then
      for b in emulator/emulator platform-tools/adb; do
        [ -x "$NODE_HOME/android/$b" ] || { echo "local node: missing $SDK/$b" >&2; exit 1; }
      done
      ls "$NODE_HOME"/android/build-tools/*/aapt2 >/dev/null 2>&1 || { echo "local node: no build-tools aapt2" >&2; exit 1; }
      echo "local node ready"; exit 0
    fi
    rc=0; _engine node-up || rc=$?
    if [ "$rc" = 3 ] || [ "$rc" = 127 ]; then
      echo "app-test-node: engine helper unavailable (rc=$rc) — direct gcloud start" >&2
      "$G" compute instances start "$NODE" --zone "$ZONE" --quiet
    elif [ "$rc" != 0 ]; then
      exit "$rc"
    fi
    for _ in $(seq 1 $(( (SSH_WAIT + 4) / 5 ))); do _ssh true 2>/dev/null && { echo "ssh ready"; exit 0; }; sleep 5; done
    echo "ssh not ready after ${SSH_WAIT}s" >&2; exit 1 ;;
  stop)
    if [ "$LOCAL" = 1 ]; then
      # Through _ssh: the same HOME/ANDROID_USER_HOME as `shot`, so it reaches the
      # adb server `shot` started (a different HOME found "no emulator", 2026-11-17).
      # Then wait for this SDK's qemu (QEMU_PAT) to exit, and force it if it does not.
      _ssh '~/android/platform-tools/adb emu kill' </dev/null >/dev/null 2>&1 || true
      for _ in $(seq 1 30); do
        pgrep -f "$QEMU_PAT" >/dev/null 2>&1 || exit 0
        sleep 1
      done
      pkill -f "$QEMU_PAT" 2>/dev/null || true
      sleep 2
      pkill -9 -f "$QEMU_PAT" 2>/dev/null || true
      exit 0
    fi
    rc=0; _engine node-down || rc=$?
    if [ "$rc" = 3 ] || [ "$rc" = 127 ]; then
      echo "app-test-node: engine helper unavailable (rc=$rc) — direct gcloud stop" >&2
      "$G" compute instances stop "$NODE" --zone "$ZONE" --quiet
    else
      exit "$rc"
    fi ;;
  ssh)
    _ssh "$1" ;;
  shot)
    apk=${1:?apk path}; wait_s=${2:-8}
    _scp_retry "$apk" "$NODE:~/under-test.apk"

    boot=$(_ssh_retry 'export ANDROID_SDK_ROOT=~/android
      ~/android/platform-tools/adb shell getprop sys.boot_completed 2>/dev/null | tr -d "\r"') || boot=0
    if [ "$boot" != 1 ]; then
      # Fire-and-forget: setsid detaches from the ssh session's controlling
      # terminal and the fds are fully redirected, so this call returns as
      # soon as the fork happens — it does not hold the channel open while
      # the emulator boots.
      _ssh_retry "$(_emu_launch api30)"
      t0=$(date +%s)
      until [ "$boot" = 1 ]; do
        sleep "$POLL_INTERVAL"
        if [ $(( $(date +%s) - t0 )) -gt "$BOOT_TIMEOUT" ]; then
          echo "boot timeout" >&2
          _ssh_retry 'tail -20 ~/emu.log' >&2 || true
          exit 1
        fi
        boot=$(_ssh_retry 'export ANDROID_SDK_ROOT=~/android
          ~/android/platform-tools/adb shell getprop sys.boot_completed 2>/dev/null | tr -d "\r"') || boot=0
      done
    fi

    # The NEWEST build-tools' aapt2: a bare `build-tools/*/aapt2` expands to every
    # installed version and aapt2 then reads the second path as its subcommand
    # (empty pkg → the launch fails). Same pick as beta_smoke._AAPT2.
    pkg=$(_ssh_retry '"$(ls -1d ~/android/build-tools/*/aapt2 | sort -V | tail -1)" dump packagename ~/under-test.apk | head -1')
    # The launch line, built here and spliced in below with the same '"$var"'
    # pattern the rest of this script uses. With no extras it is CHARACTER-FOR-
    # CHARACTER the monkey line that was inline here before, so every repo that
    # declares nothing runs exactly as it did. `$A` stays literal (the remote
    # shell assigns it); EXTRAS arrives pre-quoted for the node + device shells.
    if [ -n "$EXTRAS" ] && [ -n "$ACTIVITY" ]; then
      launch='$A shell am start -n "'"$pkg"'/'"$ACTIVITY"'" '"$EXTRAS"' >/dev/null 2>&1'
    else
      launch='$A shell monkey -p "'"$pkg"'" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1'
    fi
    _ssh_retry 'set -eo pipefail; export ANDROID_SDK_ROOT=~/android; A=~/android/platform-tools/adb
      $A install -r ~/under-test.apk | tail -1
      '"$launch"'
      sleep '"$wait_s"'
      $A exec-out screencap -p > ~/shot.png
      echo "'"$pkg"'" > ~/shot.pkg'
    mkdir -p "$OUT"
    pkg=$(_ssh_retry 'cat ~/shot.pkg' | tr -d '\r')
    dst="$OUT/$pkg-$(date +%Y%m%dT%H%M%S).png"
    _scp_retry "$NODE:~/shot.png" "$dst"
    echo "$dst" ;;
  boot)
    # Boot the AVD only (no install/launch/screenshot) so a scenario driver
    # (beta_smoke) can take over with its own adb calls. Idempotent: returns at
    # once if sys.boot_completed is already 1. Same fire-and-forget launch as
    # `shot`; `$avd` is spliced in locally (proven '"$var"' pattern).
    avd=${1:-api30}
    boot=$(_ssh_retry 'export ANDROID_SDK_ROOT=~/android
      ~/android/platform-tools/adb shell getprop sys.boot_completed 2>/dev/null | tr -d "\r"') || boot=0
    if [ "$boot" != 1 ]; then
      _ssh_retry "$(_emu_launch "$avd")"
      t0=$(date +%s)
      until [ "$boot" = 1 ]; do
        sleep "$POLL_INTERVAL"
        if [ $(( $(date +%s) - t0 )) -gt "$BOOT_TIMEOUT" ]; then
          echo "boot timeout" >&2
          _ssh_retry 'tail -20 ~/emu.log' >&2 || true
          exit 1
        fi
        boot=$(_ssh_retry 'export ANDROID_SDK_ROOT=~/android
          ~/android/platform-tools/adb shell getprop sys.boot_completed 2>/dev/null | tr -d "\r"') || boot=0
      done
    fi
    echo "booted" ;;
  push)
    # local -> node. `~` on the remote side expands via the node's shell (as `shot` relies on).
    _scp_retry "$1" "$NODE:$2" ;;
  pull)
    # node -> local.
    _scp_retry "$NODE:$1" "$2" ;;
  *)
    sed -n '2,16p' "$0"; exit 2 ;;
esac
